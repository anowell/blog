<!DOCTYPE html>
<html lang="en">
  <head>
    {% include 'head.liquid' %}
    {% if page.data.math %}<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.11/katex.min.css">{% endif %}
  </head>
  <body>
    <div class="shell">
      {% assign nav = "writing" %}
      {% include 'sidenav.liquid' %}
      <main class="main">
        <article class="post{% if page.data.transcript %} post-transcript{% endif %}">
          <div class="post-banner" style="background-image: url({{ page.data.cover_path }});"></div>
          <header class="post-header">
            <div class="post-gutter">
              <div class="mono post-date">{{ page.published_date | date: "%b %d" }}<br>{{ page.published_date | date: "%Y" }}</div>
              <div class="rule rule-short"></div>
            </div>
            <div class="post-title">
              <h1>{{ page.title }}</h1>
              <div class="rule rule-signal"></div>
              {% if page.description %}<p class="lede">{{ page.description }}</p>{% endif %}
            </div>
          </header>
          <div class="post-body">
            {{ page.content }}
          </div>
          <footer class="post-foot">
            <div class="rule"></div>
            <p class="mono">
              Written by Anthony Nowell
              <span class="slash">//</span>
              <a href="https://twitter.com/share?text={{ page.title }} via @atnowell&url={{ site.base_url }}/{{ page.permalink }}" target="_blank">Share</a>
              <span class="slash">//</span>
              <a href="mailto:anowell@gmail.com?subject={{ page.title }}">Reply</a>
            </p>
          </footer>
        </article>
      </main>
    </div>
    {% if page.content contains 'class="language-' %}<script defer src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>{% endif %}
    {% if page.data.math %}<script defer src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.11/katex.min.js"></script>
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.11/contrib/auto-render.min.js"></script>{% endif %}
    {% include 'foot.liquid' %}
    {% if page.data.transcript %}<script src="/js/transcript.js"></script>{% endif %}
  </body>
</html>
