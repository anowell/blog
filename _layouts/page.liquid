<!DOCTYPE html>
<html lang="en">
  <head>
    {% include 'head.liquid' %}
  </head>
  <body>
    <div class="shell">
      {% assign nav = page.data.nav %}
      {% include 'sidenav.liquid' %}
      <main class="main {{ page.data.page_class }}">
        {{ page.content }}
      </main>
      {% if nav == "home" %}
      <footer class="mobile-foot">
        <div class="rule rule-short"></div>
        <div class="meta">Seattle, WA</div>
        {% include 'social.liquid' %}
      </footer>
      {% endif %}
    </div>
    {% include 'foot.liquid' %}
  </body>
</html>
