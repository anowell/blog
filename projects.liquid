      tech: Rust, Axum, SQLx
      role: Creator
      status: Undermaintained
      links:
        - label: GitHub
          url: https://github.com/anowell/maglev
---
<header class="page-head">
  <h1 class="page-title">Projects</h1>
  <div class="rule rule-signal"></div>
  <p class="lede">Side projects and open source. Most of it is Rust.</p>
</header>

{% for p in page.data.projects %}
<article class="project">
  <header class="project-head">
    <h2>{{ p.name | replace: " // ", ' <span class="slash">//</span> ' }}</h2>
    <date>{{ p.dates }}</date>
  </header>

  <div class="project-body">
    <p class="project-lede">{{ p.lede }}</p>
    <p>{{ p.body }}</p>
    <dl class="project-meta">
      {% if p.tech %}<div><dt class="label">Tech</dt><dd>{{ p.tech }}</dd></div>{% endif %}
      {% if p.role %}<div><dt class="label">Role</dt><dd>{{ p.role }}</dd></div>{% endif %}
      {% if p.status %}<div><dt class="label">Status</dt><dd>{{ p.status }}</dd></div>{% endif %}
    </dl>
  </div>

  {% if p.snippets %}
  <figure class="artifact artifact-code" data-carousel data-interval="7000">
    <div class="codeframe">
      <div class="codeframe-bar"><span>{{ p.name }}</span><span class="slash">//</span><span class="codeframe-title">{{ p.snippets.first.title }}</span></div>
      <div class="slides">
        {% for s in p.snippets %}
        <pre class="slide{% if forloop.first %} is-active{% endif %}" data-title="{{ s.title }}"><code class="language-{{ s.lang }}">{{ s.code | strip | escape }}</code></pre>
        {% endfor %}
      </div>
    </div>
  </figure>
  {% elsif p.cast %}
  <figure class="artifact artifact-cast">
    <div class="cast" data-cast="{{ p.cast }}" data-cols="100" data-rows="24"></div>
  </figure>
  {% elsif p.frames %}
  <figure class="artifact artifact-frames" data-carousel>
    <div class="slides">
      {% for f in p.frames %}
      <img class="slide{% if forloop.first %} is-active{% endif %}" src="{{ f.src }}" alt="{{ f.alt }}">
      {% endfor %}
    </div>
  </figure>
  {% elsif p.image %}
  <figure class="artifact">
    <img src="{{ p.image }}" alt="{{ p.image_alt | default: p.name }}">
    {% if p.image_note %}<figcaption class="annotation" aria-hidden="true"><span class="annotation-text">{{ p.image_note }}</span></figcaption>{% endif %}
  </figure>
  {% else %}
  <figure class="artifact artifact-pending" aria-label="Screenshot pending">
    <span class="mono">Screenshot <span class="slash">//</span> pending</span>
  </figure>
  {% endif %}

  <footer class="project-links mono">
    <span>View</span>
    {% for l in p.links %}
    <span class="slash">//</span>
    {% if l.soon %}<span class="link-soon">{{ l.label }}<span class="link-soon-note">{{ l.soon }}</span></span>{% else %}<a href="{{ l.url }}">{{ l.label }}</a>{% endif %}
    {% endfor %}
  </footer>
</article>
{% endfor %}

<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/asciinema-player@3.10.0/dist/bundle/asciinema-player.min.js"></script>
<script src="/js/carousel.js"></script>
